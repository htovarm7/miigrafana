# Public log ingestion gateway: only POST /loki/api/v1/push, only with a valid X-API-Key.
server {
    listen 8080;

    location = /loki/api/v1/push {
        if ($http_x_api_key != "${GATEWAY_API_KEY}") {
            return 401;
        }

        proxy_pass http://loki:3100/loki/api/v1/push;
        proxy_set_header Host $host;
        proxy_set_header Content-Type $content_type;
    }

    location / {
        return 404;
    }
}
