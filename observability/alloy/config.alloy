// Receives telemetry from the Grafana Faro Web SDK (browser apps) and
// forwards it to Loki. Faro does not push to Loki directly - it always needs
// a receiver like this one in front. See OBSERVABILIDAD.md, "Frontend
// telemetry with Grafana Faro (web only)".
//
// Local demo only for now: not exposed through the public gateway, not part
// of docker-compose.production.yml. A real public webapp would need its own
// gated route in front of this, the same way the mobile app's logs go
// through observability/nginx/gateway.conf.template - not done here since
// this is a prototype to see the integration work, not a production path
// yet (see clients/web-faro-demo/README.md).
faro.receiver "default" {
	server {
		listen_address       = "0.0.0.0"
		listen_port          = 12347
		cors_allowed_origins = ["*"]
	}

	output {
		logs = [loki.process.default.receiver]
	}
}

// Promotes Faro's app_name field to a real "app" stream label, so
// {app="miicel-web-demo"} works the same way it already does for
// Management/Users/Mobile App - without this, everything Faro sends lands
// under Loki's default service_name="unknown_service" label instead, which
// the other dashboards' queries don't expect.
loki.process "default" {
	forward_to = [loki.write.default.receiver]

	stage.logfmt {
		mapping = { "app_name" = "" }
	}

	stage.labels {
		values = {
			"app" = "app_name",
		}
	}
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
