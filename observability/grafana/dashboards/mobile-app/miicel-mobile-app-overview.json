      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({app=\"miicel-mobile\"} | json | env=~\"$env\" | platform=~\"$platform\" | Event=~\"app.crash|app.render_error|app.unhandled_rejection\" [$__range])) or vector(0)",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },
