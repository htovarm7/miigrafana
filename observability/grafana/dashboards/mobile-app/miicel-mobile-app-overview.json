{
  "title": "MiiCel Back - Mobile App (React Native)",
  "uid": "miicel-mobile-app-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "search",
        "type": "textbox",
        "label": "Search logs (regex)",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" }
      },
      {
        "name": "userId",
        "type": "textbox",
        "label": "UserId (audit)",
        "description": "Filters the audit panel by UserId. Use .+ for all users.",
        "query": ".+",
        "current": { "text": ".+", "value": ".+" }
      },
      {
        "name": "correlationId",
        "type": "textbox",
        "label": "CorrelationId (trace of one session/operation)",
        "description": "Use .+ for everything, or paste one CorrelationId to see that operation only.",
        "query": ".+",
        "current": { "text": ".+", "value": ".+" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "No Prometheus metrics for this service",
      "type": "text",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Mobile app logs arrive through the gateway (POST /loki/api/v1/push), not scraped by Prometheus."
      }
    },
    {
      "id": 2,
      "title": "Errores (level=error)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 3 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=\"miicel-mobile\"} | json | level=\"error\" |~ \"$search\""
        }
      ]
    },
    {
      "id": 3,
      "title": "All logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 11 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=\"miicel-mobile\"} |~ \"$search\""
        }
      ]
    },
    {
      "id": 4,
      "title": "Audit: what user $userId did before failing",
      "description": "Errors only, filtered by UserId.",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=\"miicel-mobile\"} | json | level=\"error\" | UserId=~\"$userId\""
        }
      ]
    },
    {
      "id": 5,
      "title": "Full trace of one session/operation ($correlationId)",
      "description": "Every line sharing the same CorrelationId, any level.",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Ascending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=\"miicel-mobile\"} | json | CorrelationId=~\"$correlationId\""
        }
      ]
    }
  ]
}
