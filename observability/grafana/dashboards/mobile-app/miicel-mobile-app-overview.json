    {
      "id": 12,
      "title": "Crashes",
      "description": "Crashes, render errors and unhandled promise rejections, with Breadcrumbs and Stack.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessages": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{app=\"miicel-mobile\"} | json | env=~\"$env\" | platform=~\"$platform\" | Event=~\"app.crash|app.render_error|app.unhandled_rejection\" |~ \"$search\" | line_format `{{.level}} | {{.Event}} | socio {{.UserId | default \"-\"}} emp {{.Company | default \"-\"}} | {{.platform}} {{.AppVersion}} | pantalla: {{.Screen | default \"-\"}}{{ \"\\n\" }}  motivo: {{.Reason}}{{if .ErrorName}} ({{.ErrorName}}){{end}}{{if .Endpoint}}{{ \"\\n\" }}  api: {{.Endpoint}} {{.Status}} {{.DurationMs}}ms{{end}}{{if .Stack}}{{ \"\\n\" }}  stack: {{.Stack}}{{end}}{{if .Breadcrumbs}}{{ \"\\n\" }}  pasos previos: {{.Breadcrumbs}}{{end}}`",
          "refId": "A"
        }
      ]
    },
