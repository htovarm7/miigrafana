{
  "title": "MiiCel Back - Management (local)",
  "uid": "miicel-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "search",
        "type": "textbox",
        "label": "Buscar en logs (regex)",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" }
      },
      {
        "name": "userId",
        "type": "textbox",
        "label": "UserId (auditoria)",
        "description": "Filtra el panel de auditoria por el UserId del claim JWT (o el que se manda a /api/home/test-error). Dejar en .+ para ver todos los usuarios.",
        "query": ".+",
        "current": { "text": ".+", "value": ".+" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Servicio arriba/abajo",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=\"miicel-api-management\"}",
          "legendFormat": "management"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Requests por endpoint (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"miicel-api-management\"}[1m]))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tasa de error 5xx por endpoint (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"miicel-api-management\", http_response_status_code=~\"5..\"}[1m]))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latencia p95 por endpoint (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"miicel-api-management\"}[5m])))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Errores (level=error)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=\"miicel-api-management\"} | json | level=\"error\" |~ \"$search\""
        }
      ]
    },
    {
      "id": 5,
      "title": "Todos los logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=\"miicel-api-management\"} |~ \"$search\""
        }
      ]
    },
    {
      "id": 7,
      "title": "Auditoria: que hizo el usuario $userId antes de fallar",
      "description": "Solo errores (level=error), filtrados por UserId. Muestra el request/accion que se estaba ejecutando (Endpoint), el motivo si vino en la query (Reason) y la excepcion completa. Usar para responder 'el usuario X reporto que Y fallo, que paso'.",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=\"miicel-api-management\"} | json | level=\"error\" | UserId=~\"$userId\""
        }
      ]
    }
  ]
}
